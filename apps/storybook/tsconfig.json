{
  "extends": "@tuquet/tsconfig/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@/*": ["../../packages/vue-ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    ".storybook/**/*.ts",
    "../../packages/vue-table/src/**/*.stories.ts",
    "../../packages/vue-ui/src/**/*.stories.ts"
  ]
}
