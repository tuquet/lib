{
  "name": "@tuquet/lib",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @tuquet Node.js libraries",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuquet/lib.git"
  },
  "license": "MIT",
  "author": "Tuquet Team <dev@tuquet.com>",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=1536\" turbo run build --filter=\"./packages/*\" --concurrency=2",
    "build:packages": "cross-env NODE_OPTIONS=\"--max-old-space-size=1536\" turbo run build --filter=\"./packages/*\" --concurrency=2",
    "build:apps": "cross-env NODE_OPTIONS=\"--max-old-space-size=1536\" turbo run build --filter=\"./apps/*\" --concurrency=2",
    "build:all": "cross-env NODE_OPTIONS=\"--max-old-space-size=1536\" turbo run build --concurrency=2",
    "dev": "turbo run dev",
    "test": "turbo run test && pnpm check:docs",
    "test:watch": "vitest",
    "typecheck": "cross-env NODE_OPTIONS=\"--max-old-space-size=1536\" turbo run typecheck --concurrency=2",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "check:exports": "turbo run check:exports",
    "check:docs": "node tooling/scripts/check-docs.mjs",
    "storybook": "turbo run dev --filter=@tuquet/storybook",
    "build:storybook": "cross-env NODE_OPTIONS=\"--max-old-space-size=1536\" turbo run build --filter=@tuquet/storybook --concurrency=2",
    "verify:storybook": "node tooling/scripts/verify-storybook.mjs",
    "preview:storybook": "pnpm --filter=@tuquet/storybook preview",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/node": "^22.20.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
