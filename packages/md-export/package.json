{
  "name": "@tuquet/md-export",
  "version": "0.1.1",
  "description": "Folder-aware Markdown to PDF, HTML, PNG, and JPEG multi-format exporter using headless Chromium",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "tuquet-md-export": "./dist/cli.cjs",
    "tuquet-md-pdf": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Tuquet <dev@tuquet.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuquet/lib.git",
    "directory": "packages/md-export"
  },
  "keywords": [
    "tuquet",
    "markdown",
    "pdf",
    "compiler",
    "puppeteer",
    "markdown-pdf",
    "folder-aware"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "fast-glob": "^3.3.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "puppeteer-core": "^24.4.0"
  },
  "devDependencies": {
    "@tuquet/eslint-config": "workspace:*",
    "@tuquet/tsconfig": "workspace:*",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
